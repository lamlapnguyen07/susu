# =====================================================
#  食在好蔬 — 環境變數範本（複製成 .env 後填入真實值）
#  ⚠️ .env 內含密鑰，已被 .gitignore 排除，絕不要 commit
# =====================================================

# ---- 後台 2FA / Flask ----
ADMIN_TOTP_SECRET=         # 用 web/setup_2fa.py 產生
FLASK_SECRET=              # 任意長隨機字串
ADMIN_PATH=lidmin          # 後台網址路徑（不好猜的字串）
ADMIN_USER=                # 後台帳號
ADMIN_PASS=                # 後台密碼
FLASK_SECURE_COOKIE=1      # HTTPS 部署設 1；純 http 測試設 0

# ---- LINE LIFF（訂購頁）----
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# ---- LINE Bot（push 服務）----
LINE_CHANNEL_ACCESS_TOKEN= # 一長串，中間不可有空格！
LINE_CHANNEL_SECRET=

# ---- 對外公開網址（push 推 QR 圖用）----
PUBLIC_BASE_URL=https://你的網域      # 例：https://eatgoodveg.com

# ---- 資料庫（web 與 push 共用）----
DB_HOST=192.168.1.103       # NAS 區網 IP；連不到改 host.docker.internal
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=susu

# ---- 選填 ----
# DAILY_PACK_LIMIT=10       # 每帳號每天最多幾包（防刷單，預設 10）
# ORDER_RATE_LIMIT=30       # 每 IP 每小時最多幾筆訂單（預設 30）
